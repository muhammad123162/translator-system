# =====================================================================
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.
# =====================================================================

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000

# --- MySQL Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=translator_app
DB_PASSWORD=change_me
DB_NAME=translator_db
DB_CONNECTION_LIMIT=10

# --- JWT Authentication ---
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# --- bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- Google Cloud Translation API v3 ---
# Service account JSON key file path (recommended for server-to-server auth)
GOOGLE_APPLICATION_CREDENTIALS=./server/config/google-credentials.json
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
TRANSLATE_RATE_LIMIT_MAX_REQUESTS=30
