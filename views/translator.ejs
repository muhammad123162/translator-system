<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>">
  <%- include('partials/app-topbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('partials/sidebar') %>

      <main class="col-12 col-lg-10 app-main">
        <h3 class="mb-1">Translator</h3>
        <p class="text-muted-soft mb-4">Translate text instantly using the Google Cloud Translation API.</p>

        <div class="card-nsuk translator-panel p-4">
          <!-- Language selectors -->
          <div class="row align-items-center g-2 mb-3">
            <div class="col-5">
              <select class="form-select" id="sourceLanguage">
                <option value="auto" selected>Detect Language</option>
              </select>
            </div>
            <div class="col-2 text-center">
              <button type="button" class="lang-swap-btn" id="swapBtn" title="Swap languages">
                <i class="fa-solid fa-arrow-right-arrow-left"></i>
              </button>
            </div>
            <div class="col-5">
              <select class="form-select" id="targetLanguage">
                <!-- populated dynamically -->
              </select>
            </div>
          </div>

          <!-- Text areas -->
          <div class="row g-3">
            <div class="col-md-6">
              <textarea class="form-control" id="sourceText" placeholder="Enter text to translate..." maxlength="5000"></textarea>
              <div class="d-flex justify-content-between mt-1">
                <span class="char-counter"><span id="charCount">0</span> / 5000</span>
                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="clearBtn">
                  <i class="fa-solid fa-xmark me-1"></i>Clear
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <textarea class="form-control bg-light" id="translatedText" placeholder="Translation will appear here..." readonly></textarea>
              <div class="d-flex justify-content-end gap-3 mt-1 translator-toolbar">
                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="copyBtn">
                  <i class="fa-solid fa-copy me-1"></i>Copy
                </button>
                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="downloadBtn">
                  <i class="fa-solid fa-download me-1"></i>Download
                </button>
                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="favoriteBtn" disabled>
                  <i class="fa-regular fa-star me-1"></i>Favorite
                </button>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-4">
            <span class="small text-muted-soft" id="detectedLanguageLabel"></span>
            <button type="button" class="btn btn-nsuk-primary px-5" id="translateBtn">
              <i class="fa-solid fa-language me-2"></i>Translate
            </button>
          </div>
        </div>

        <!-- Recent translations panel -->
        <div class="card-nsuk p-3 mt-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">Recent Translations</h6>
            <a href="/history" class="small">Full history <i class="fa-solid fa-arrow-right ms-1"></i></a>
          </div>
          <div id="sidebarHistoryList" class="list-group list-group-flush">
            <div class="text-center text-muted-soft py-3">Loading...</div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('partials/overlays') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/translator.js"></script>
</body>
</html>
