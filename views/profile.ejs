<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>">
  <%- include('partials/app-topbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('partials/sidebar') %>

      <main class="col-12 col-lg-10 app-main">
        <h3 class="mb-1">My Profile</h3>
        <p class="text-muted-soft mb-4">Manage your account details and password.</p>

        <div class="row g-4">
          <div class="col-lg-7">
            <div class="card-nsuk p-4 mb-4">
              <h6 class="mb-3">Account Information</h6>
              <form id="profileForm" novalidate>
                <div class="mb-3">
                  <label class="form-label">Full Name</label>
                  <input type="text" class="form-control" id="name" required minlength="2">
                </div>
                <div class="mb-3">
                  <label class="form-label">Email Address</label>
                  <input type="email" class="form-control" id="email" required>
                </div>
                <div class="mb-0">
                  <label class="form-label">Role</label>
                  <input type="text" class="form-control" id="role" disabled>
                </div>
                <button type="submit" class="btn btn-nsuk-primary mt-3"><i class="fa-solid fa-floppy-disk me-2"></i>Save Changes</button>
              </form>
            </div>

            <div class="card-nsuk p-4">
              <h6 class="mb-3">Change Password</h6>
              <form id="passwordForm" novalidate>
                <div class="mb-3">
                  <label class="form-label">Current Password</label>
                  <input type="password" class="form-control" id="currentPassword" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">New Password</label>
                  <input type="password" class="form-control" id="newPassword" required minlength="8">
                  <div class="form-text">At least 8 characters, including a number.</div>
                </div>
                <button type="submit" class="btn btn-nsuk-outline"><i class="fa-solid fa-key me-2"></i>Update Password</button>
              </form>
            </div>
          </div>

          <div class="col-lg-5">
            <div class="card-nsuk p-4 text-center">
              <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3"
                   style="width:88px; height:88px; background: var(--nsuk-gold-400); color: var(--nsuk-green-900); font-size:2rem; font-weight:800; font-family: var(--font-heading);"
                   id="profileAvatar">U</div>
              <h5 class="mb-0" id="profileName">—</h5>
              <p class="text-muted-soft small mb-3" id="profileEmail">—</p>
              <span class="badge badge-role-user" id="profileRoleBadge">User</span>

              <hr class="my-4">

              <div class="row text-start g-3">
                <div class="col-6">
                  <small class="text-muted-soft d-block">Total Translations</small>
                  <div class="fw-bold" id="profileTotal">—</div>
                </div>
                <div class="col-6">
                  <small class="text-muted-soft d-block">Languages Used</small>
                  <div class="fw-bold" id="profileLanguages">—</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('partials/overlays') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/profile.js"></script>
</body>
</html>
