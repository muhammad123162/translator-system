<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>">
  <div class="container">
    <div class="row justify-content-center align-items-center min-vh-100 py-5">
      <div class="col-lg-9">
        <div class="auth-card row g-0">
          <div class="col-md-5 auth-side d-none d-md-flex flex-column justify-content-center order-md-2">
            <span class="brand-mark mb-3" style="width:44px;height:44px;">LB</span>
            <h3 class="text-white font-heading">Join LinguaBridge</h3>
            <p class="text-white-50">Create a free account to start translating and keep a personal history
              of everything you've translated.</p>
            <ul class="list-unstyled small mt-4">
              <li><i class="fa-solid fa-check text-warning me-2"></i>Free, no credit card required</li>
              <li><i class="fa-solid fa-check text-warning me-2"></i>Secure, encrypted password storage</li>
              <li><i class="fa-solid fa-check text-warning me-2"></i>Takes less than a minute</li>
            </ul>
          </div>
          <div class="col-md-7 p-5 order-md-1">
            <h4 class="mb-1">Create Your Account</h4>
            <p class="text-muted-soft mb-4">It's free and only takes a moment.</p>

            <form id="registerForm" novalidate>
              <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Amina Yusuf" required minlength="2">
                <div class="invalid-feedback">Please enter your full name.</div>
              </div>
              <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="you@example.com" required>
                <div class="invalid-feedback">Please enter a valid email address.</div>
              </div>
              <div class="mb-3">
                <label class="form-label">Password</label>
                <div class="input-group">
                  <input type="password" class="form-control" id="password" name="password" placeholder="At least 8 characters, with a number" required minlength="8">
                  <button class="btn btn-outline-secondary" type="button" id="togglePassword"><i class="fa-solid fa-eye"></i></button>
                </div>
                <div class="invalid-feedback">Password must be at least 8 characters and include a number.</div>
              </div>
              <div class="mb-4">
                <label class="form-label">Confirm Password</label>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Re-enter your password" required>
                <div class="invalid-feedback">Passwords do not match.</div>
              </div>
              <button type="submit" class="btn btn-nsuk-primary w-100 mb-3" id="registerSubmitBtn">
                <i class="fa-solid fa-user-plus me-2"></i>Create Account
              </button>
              <p class="text-center small text-muted-soft mb-0">
                Already have an account? <a href="/login">Log in</a>
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/overlays') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>
