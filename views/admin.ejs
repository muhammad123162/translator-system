<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
</head>
<body class="<%= bodyClass %>">
  <%- include('partials/app-topbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('partials/sidebar') %>

      <main class="col-12 col-lg-10 app-main">
        <h3 class="mb-1">Admin Dashboard</h3>
        <p class="text-muted-soft mb-4">System-wide overview, user management, and translation monitoring.</p>

        <!-- Stat cards -->
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="card-nsuk stat-card p-3">
              <small class="text-muted-soft text-uppercase">Total Users</small>
              <div class="stat-value" id="adminTotalUsers">—</div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card-nsuk stat-card p-3">
              <small class="text-muted-soft text-uppercase">Total Translations</small>
              <div class="stat-value" id="adminTotalTranslations">—</div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card-nsuk stat-card p-3">
              <small class="text-muted-soft text-uppercase">API Errors Logged</small>
              <div class="stat-value" id="adminApiErrors">—</div>
            </div>
          </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" id="adminTabs">
          <li class="nav-item"><button class="nav-link active" data-tab="overview">Overview</button></li>
          <li class="nav-item"><button class="nav-link" data-tab="users">Users</button></li>
          <li class="nav-item"><button class="nav-link" data-tab="logs">Translation Logs</button></li>
          <li class="nav-item"><button class="nav-link" data-tab="languages">Languages</button></li>
        </ul>

        <!-- Overview tab -->
        <div class="admin-tab-pane" id="tab-overview">
          <div class="row g-3">
            <div class="col-lg-7">
              <div class="card-nsuk p-3">
                <h6 class="mb-3">Translation Volume — Last 14 Days</h6>
                <canvas id="volumeChart" height="140"></canvas>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="card-nsuk p-3">
                <h6 class="mb-3">Most Translated-To Languages</h6>
                <canvas id="languageChart" height="180"></canvas>
              </div>
            </div>
          </div>
        </div>

        <!-- Users tab -->
        <div class="admin-tab-pane d-none" id="tab-users">
          <div class="card-nsuk p-3">
            <div class="table-responsive">
              <table class="table table-nsuk align-middle mb-0">
                <thead>
                  <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody id="usersTableBody">
                  <tr><td colspan="6" class="text-center text-muted-soft py-4">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Logs tab -->
        <div class="admin-tab-pane d-none" id="tab-logs">
          <div class="card-nsuk p-3">
            <div class="table-responsive">
              <table class="table table-nsuk align-middle mb-0">
                <thead>
                  <tr><th>User</th><th>Pair</th><th>Date</th></tr>
                </thead>
                <tbody id="logsTableBody">
                  <tr><td colspan="3" class="text-center text-muted-soft py-4">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Languages tab -->
        <div class="admin-tab-pane d-none" id="tab-languages">
          <div class="card-nsuk p-3">
            <p class="text-muted-soft small">Toggle which languages are available in the Translator's dropdowns.
              The project currently scopes translation to English, Hausa, Igbo, and Yoruba.</p>
            <div class="table-responsive">
              <table class="table table-nsuk align-middle mb-0">
                <thead><tr><th>Language</th><th>Code</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                <tbody id="languagesTableBody">
                  <tr><td colspan="4" class="text-center text-muted-soft py-4">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Delete user confirmation modal -->
  <div class="modal fade" id="deleteUserModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Delete User</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">This will permanently delete the user account and all of their translation
          history. This action cannot be undone.</div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger" id="confirmDeleteUserBtn">Delete User</button>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/overlays') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
