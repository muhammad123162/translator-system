<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>">
  <%- include('partials/app-topbar') %>
  <div class="container-fluid">
    <div class="row">
      <%- include('partials/sidebar') %>

      <main class="col-12 col-lg-10 app-main">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
          <div>
            <h3 class="mb-1">Translation History</h3>
            <p class="text-muted-soft mb-0">Search, favorite, or remove past translations.</p>
          </div>
          <button class="btn btn-nsuk-outline" id="clearAllBtn"><i class="fa-solid fa-trash-can me-2"></i>Clear All</button>
        </div>

        <div class="card-nsuk p-3 mb-3">
          <div class="row g-2 align-items-center">
            <div class="col-md-6">
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" class="form-control" id="searchInput" placeholder="Search original or translated text...">
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-check form-switch mt-2 mt-md-0">
                <input class="form-check-input" type="checkbox" id="favoritesOnly">
                <label class="form-check-label small" for="favoritesOnly">Favorites only</label>
              </div>
            </div>
            <div class="col-md-3 text-md-end">
              <span class="small text-muted-soft" id="resultsCount"></span>
            </div>
          </div>
        </div>

        <div class="card-nsuk p-3">
          <div class="table-responsive">
            <table class="table table-nsuk align-middle mb-0">
              <thead>
                <tr>
                  <th>Original Text</th>
                  <th>Translated Text</th>
                  <th>Pair</th>
                  <th>Date</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="historyTableBody">
                <tr><td colspan="5" class="text-center text-muted-soft py-4">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <nav class="mt-3">
          <ul class="pagination justify-content-center" id="pagination"></ul>
        </nav>
      </main>
    </div>
  </div>

  <!-- Delete confirmation modal -->
  <div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Confirm Deletion</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">Are you sure you want to delete this translation? This cannot be undone.</div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/overlays') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/history.js"></script>
</body>
</html>
